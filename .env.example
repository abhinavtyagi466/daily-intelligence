# Supabase project or local CLI instance
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local example http://127.0.0.1:3000/api/mcp
MCP_SERVER_URL=
# Temporary loopback token for SDK testing with npm run dev (32+ characters)
MCP_AUTH_SECRET=
# Hosted OAuth with the Descope project issuer
DESCOPE_PROJECT_ID=
# Optional HTTPS origin if your Descope project uses a different API hostname
DESCOPE_BASE_URL=
MCP_OAUTH_ALLOWED_SUBJECTS=
# Explicit issuer and JWKS pair for other OAuth configurations
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
# Additional comma-separated Origin values sent by trusted clients
MCP_ALLOWED_ORIGINS=

# Optional Crossref polite-pool contact
CROSSREF_CONTACT_EMAIL=

# Optional browser smoke test against local Supabase
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_BROWSER_CHANNEL=
